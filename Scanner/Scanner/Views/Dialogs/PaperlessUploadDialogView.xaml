<ContentDialog
    x:Class="Scanner.Views.Dialogs.PaperlessUploadDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Scanner.ViewModels"
    xmlns:paperless="using:Scanner.Models.Paperless"
    xmlns:strings="using:Scanner.Resources.Strings"
    mc:Ignorable="d"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind strings:Resources.PaperlessSend}"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanUpload, Mode=OneWay}"
    CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
    FlowDirection="{x:Bind AccessibilityService.DefaultFlowDirection, Mode=OneWay}"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    Opened="ContentDialog_Opened"
    Closed="ContentDialog_Closed">


    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  RESOURCES  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///StylesDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
            <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>

            <DataTemplate x:Key="PaperlessEntityTemplate" x:DataType="paperless:PaperlessEntity">
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
        </ResourceDictionary>
    </ContentDialog.Resources>


    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - -  PAGE CONTENT  - - - - - - - - - - - - - - - - -->
    <!-- - - - - - - - - - - - - - - - - - - -  - - - - - - - - - - - - - - - - - - - - -->
    <ContentDialog.Title>
        <TextBlock Text="{x:Bind strings:Resources.PaperlessUploadDialogHeading}" Margin="0,0,0,12" />
    </ContentDialog.Title>

    <ScrollViewer Padding="0,0,18,0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Margin="0,4,0,12">

            <!-- Loading data from Paperless -->
            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Errors -->
            <InfoBar Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Title="{x:Bind strings:Resources.PaperlessUploadFailedHeading}"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />

            <!-- Result -->
            <InfoBar Severity="Success" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.IsDone, Mode=OneWay}"
                     Title="{x:Bind strings:Resources.PaperlessUploadSuccessHeading}"
                     Message="{x:Bind ViewModel.ResultText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="{x:Bind strings:Resources.PaperlessOpenInPaperless}"
                                     NavigateUri="{x:Bind ViewModel.DocumentUri, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.HasDocumentUri, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Metadata form -->
            <ContentControl HorizontalContentAlignment="Stretch" IsTabStop="False"
                            IsEnabled="{x:Bind ViewModel.IsFormEnabled, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsFormVisible, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind strings:Resources.PaperlessMultipleFilesHint}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.IsHandlingMultipleFiles}" />

                    <TextBox Header="{x:Bind strings:Resources.PaperlessTitle}"
                             PlaceholderText="{x:Bind ViewModel.SuggestedTitle}"
                             Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CalendarDatePicker Grid.Column="0" HorizontalAlignment="Stretch"
                                            Header="{x:Bind strings:Resources.PaperlessCreated}"
                                            PlaceholderText="{x:Bind strings:Resources.PaperlessAutomatic}"
                                            Date="{x:Bind ViewModel.Created, Mode=TwoWay}" />
                        <NumberBox Grid.Column="1"
                                   Header="{x:Bind strings:Resources.PaperlessArchiveSerialNumber}"
                                   PlaceholderText="{x:Bind strings:Resources.PaperlessAutomatic}"
                                   Minimum="0" SmallChange="1" LargeChange="10"
                                   SpinButtonPlacementMode="Hidden"
                                   Value="{x:Bind ViewModel.ArchiveSerialNumber, Mode=TwoWay}" />
                    </Grid>

                    <ComboBox HorizontalAlignment="Stretch"
                              Header="{x:Bind strings:Resources.PaperlessCorrespondent}"
                              ItemTemplate="{StaticResource PaperlessEntityTemplate}"
                              ItemsSource="{x:Bind ViewModel.Correspondents, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedCorrespondent, Mode=TwoWay}" />

                    <ComboBox HorizontalAlignment="Stretch"
                              Header="{x:Bind strings:Resources.PaperlessDocumentType}"
                              ItemTemplate="{StaticResource PaperlessEntityTemplate}"
                              ItemsSource="{x:Bind ViewModel.DocumentTypes, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedDocumentType, Mode=TwoWay}" />

                    <ComboBox HorizontalAlignment="Stretch"
                              Header="{x:Bind strings:Resources.PaperlessStoragePath}"
                              ItemTemplate="{StaticResource PaperlessEntityTemplate}"
                              ItemsSource="{x:Bind ViewModel.StoragePaths, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedStoragePath, Mode=TwoWay}" />

                    <!-- Tags -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.TagsHeaderText, Mode=OneWay}" />
                        <TextBox PlaceholderText="{x:Bind strings:Resources.PaperlessTagsFilterPlaceholder}"
                                 Text="{x:Bind ViewModel.TagFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <ListView MaxHeight="200" SelectionMode="None" IsItemClickEnabled="False"
                                      ItemsSource="{x:Bind ViewModel.FilteredTags, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:PaperlessTagItem">
                                        <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        <TextBlock Text="{x:Bind strings:Resources.PaperlessNoTags}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.HasNoTags, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <!-- Upload progress -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsUploading, Mode=OneWay}">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
